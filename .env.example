# ZEGOCLOUD credentials, from https://console.zegocloud.com
#
# Both are SERVER-ONLY and are read by api/zego-token.js at runtime.
#
# Do NOT prefix these with VITE_ or QCLI_, and do NOT add them to
# quasar.config.js > build.env. Quasar auto-loads .env files and Vite replaces
# every import.meta.env reference with a literal string, so anything the client
# bundle can reach is published to every visitor who opens DevTools.
#
# Set the same two variables in Vercel > Project Settings > Environment Variables.

ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
